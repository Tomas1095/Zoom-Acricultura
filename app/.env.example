# Copiar a .env y completar con los datos del proyecto de Supabase
# (Project Settings → API en el dashboard de supabase.com).
# El prefijo EXPO_PUBLIC_ es necesario para que Expo exponga estas variables
# al código de la app — no poner acá nada secreto (la anon key es pública
# por diseño, la seguridad real la da RLS en la base).

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Imagen satelital de fondo del mapa de densidad (ver lib/geo/satelital.ts).
# Key gratuita de Bing Maps — sacala en https://www.bingmapsportal.com
# (My account → My keys → Create). Sin esta variable, el mapa de densidad
# funciona igual, solo que sin la foto de fondo (fondo claro liso).
EXPO_PUBLIC_BING_MAPS_KEY=TU-BING-MAPS-KEY
